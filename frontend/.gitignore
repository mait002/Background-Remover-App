# ==============================================================================
# 3. ENVIRONMENT VARIABLES & SECRETS (Crucial)
# ==============================================================================
# Ignore local environment files containing real API keys/passwords
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# DO NOT ignore the example file so team members know what variables are required
!.env.example

# Database files (if using a local SQLite instance for testing)
*.db
*.sqlite3
*.sqlite3-journal

